# Copy to .env and enter a long, unique password before starting Docker Compose.
# Single quotes preserve literal characters such as $ and # in Compose .env files.
# Leave blank here: Compose refuses to start with an empty password.
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6543
POSTGRES_DB=nhl_analytics

# Optional prediction API configuration (does not modify the database).
# Leave the run blank to select the newest complete saved evaluation at startup.
NHL_PREDICTIONS_RUN=
NHL_API_CACHE_DIR=.work/api-cache
# Example React origins: http://localhost:5173,http://127.0.0.1:5173
NHL_API_CORS_ORIGINS=

# Daily forecast publications; API follows this automatically unless --run or
# NHL_PREDICTIONS_RUN pins a historical evaluation. All paths remain on D:.
NHL_DAILY_ROOT=data/predictions/daily

# One shared GameCenter collector runs with an unpinned API by default.
# Set to 0 for saved forecasts only. Keep polling >=15 seconds.
NHL_LIVE_ENABLED=1
NHL_LIVE_POLL_SECONDS=20

# Prospective tracker starts with the unpinned API; it uses frozen artifacts.
NHL_PROSPECTIVE_ENABLED=1
NHL_PROSPECTIVE_INTERVAL_SECONDS=30
NHL_PROSPECTIVE_REPORT_ROOT=data/prospective/reports
# Leave blank to use the pinned initial comparison run on first registration.
# Existing campaigns always reuse their immutable database model bundle.
NHL_PROSPECTIVE_MODEL_RUN=
